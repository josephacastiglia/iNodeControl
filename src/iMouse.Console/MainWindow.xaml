<Window x:Class="IMouse2.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iMouse 2.0 — Independent AirPlay" Width="1420" Height="940" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">

  <!-- The working surface is the phones and nothing else. Everything not needed while
       actually driving a rack - service address, command buttons, board binding, the
       activity log - lives in a drawer that has to be opened. The status bar carries the
       two size sliders and their refresh rates, as the original console does. -->
  <Grid>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <!-- ================= top bar ================= -->
      <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="12,7">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="iMouse" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text=" 2.0" FontSize="16" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
            <Button x:Name="RackViewTabButton" Content="Rack View" Click="RackViewTab_Click" Margin="0,0,4,0" MinHeight="28" Padding="12,5"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}"/>
            <Button x:Name="FarmTabButton" Content="Marketing Farm (Test Tab)" Click="FarmTab_Click" Margin="0,0,8,0" MinHeight="28" Padding="12,5"
                    ToolTip="Switch to 19-iPhone Marketing Farm &amp; Social Automation Test Tab"/>
            <Rectangle Width="1" Height="20" Fill="{DynamicResource EdgeBrush}" Margin="4,0,8,0"/>
            <Button x:Name="ControlsButton" Content="Controls" Click="OpenControls_Click" Margin="0,0,6,0" MinHeight="28" Padding="12,5"/>
            <Button x:Name="SettingsButton" Content="Settings" Click="OpenSettings_Click" Margin="0,0,6,0" MinHeight="28" Padding="12,5"/>
            <Button x:Name="ActivityButton" Content="Activity" Click="OpenActivity_Click" Margin="0,0,6,0" MinHeight="28" Padding="12,5"/>
            <Button x:Name="StopInputButton" Content="Stop input" Click="StopInput_Click" Margin="8,0,4,0" Foreground="#C62828" ToolTip="Stop input on the selected phone and enabled followers; video continues"/>
            <Button x:Name="ResumeInputButton" Content="Resume input" Click="ResumeInput_Click" ToolTip="Explicitly allow new input after cleanup"/>
          </StackPanel>
          <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,8,0"
                  Background="{DynamicResource TargetBrush}" BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="8,2">
            <TextBlock x:Name="BuildIdentity" Text="v2.0-rc1 · Independent AirPlay" FontSize="11"
                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBlock x:Name="ConnectionStatus" Text="Not connected" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right"/>
              <TextBlock x:Name="Totals" Text="Connect to your iMouse service" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Right"/>
              <TextBlock x:Name="InputStateText" Text="Input not connected" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
            </StackPanel>
            <Button x:Name="ThemeButton" Content="Night" Click="Theme_Click" Style="{StaticResource Quiet}" VerticalAlignment="Center"
                    ToolTip="Switch between the light and night palette" AutomationProperties.Name="Toggle night mode"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ================= phones =================
           Nothing is centred or stretched. The master sits at the top left at whatever size
           the Large screen slider says, and the small screens flow to its right and wrap,
           the way the original console lays them out. The whole surface scrolls, so the
           master can be pushed past the window and panned. -->
      <Grid x:Name="RackViewSurface" Grid.Row="1" Margin="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="DeviceColumn" Width="212" MinWidth="0"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Panel}" Padding="8">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="Search devices" MinHeight="26" Padding="6,3" FontSize="12"/>
              <CheckBox x:Name="OnlineOnly" Grid.Column="1" Content="Online" Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="7,0,0,0" FontSize="11.5" VerticalAlignment="Center"/>
              <ComboBox x:Name="GroupFilter" SelectionChanged="Group_Changed" AutomationProperties.Name="Filter by group" Visibility="Collapsed"/>
            </Grid>
            <!-- One switch that puts every phone under the master. Unticking it releases
                 them again, which is the fast way out if a mirrored action goes wrong. -->
            <CheckBox x:Name="SelectAllBox" Grid.Row="1" Click="SelectAll_Click" Margin="2,0,0,6" VerticalAlignment="Center"
                      AutomationProperties.Name="Mirror the master's actions to every phone">
              <TextBlock x:Name="SelectAllLabel" Text="Mirror to all" FontSize="11.5"/>
            </CheckBox>

            <Grid Grid.Row="2">
              <ListBox x:Name="DeviceList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" SelectionChanged="Device_Changed"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="iPhones">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template"><Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{DynamicResource ItemBrush}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="6,4">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/></Trigger>
                          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value></Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Padding="0" MinHeight="0"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat=Mirror to {0}}"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                        <TextBlock Text="{Binding ChannelSummary}" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChannelSummary}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                              <Style.Triggers><DataTrigger Binding="{Binding ControlReady}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OkBrush}"/></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="EmptyList" Text="Connect to load your iPhones." TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11.5" Margin="4,10" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Grid>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="10,6,10,5">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SelectedTitle" Text="Select an iPhone" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SelectedDetails" Text="" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock x:Name="PointerReadout" Grid.Column="1" Text="" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock x:Name="PreviewFreshnessText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0"
                         Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" IsHitTestVisible="True"
                         Visibility="Collapsed" AutomationProperties.Name="Preview delivery status"/>
            </Grid>

            <ScrollViewer x:Name="MasterScroll" Grid.Row="1" Background="{DynamicResource StageBrush}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="MasterScroll_SizeChanged">
              <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                  <Image x:Name="PhoneImage" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                         MouseLeftButtonDown="Preview_Down" MouseLeftButtonUp="Preview_Up" LostMouseCapture="Preview_LostCapture"
                         MouseMove="Preview_Move" MouseLeave="Preview_Leave" AutomationProperties.Name="Master iPhone screen"/>
                  <StackPanel x:Name="PreviewPlaceholder" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,20,24,0">
                    <TextBlock x:Name="PreviewHeading" Text="Your phone, here." FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PreviewMessage" Text="Select an online iPhone to start its screen." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" MaxWidth="300"/>
                  </StackPanel>
                </Grid>

                <!-- The original console keeps its actions in a narrow strip against the
                     master rather than in a distant panel. Every button here is an input
                     command and follows the mirror set. Mirroring itself is started and
                     stopped on the iPhone. -->
                <StackPanel x:Name="ActionStrip" Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Top">
                  <Button x:Name="ResetButton" Content="Reset" Tag="reset|mouse" Click="Action_Click" Width="76" Margin="0,0,0,5" MinHeight="30"
                          ToolTip="Re-centre the phone pointer so it lines up with the mouse again"/>
                  <Button x:Name="HomeButton" Content="Home" Tag="key|Home" Click="Action_Click" Width="76" Margin="0,0,0,5" MinHeight="30"
                          ToolTip="Send the phone to its home screen"/>
                  <Button x:Name="CtrlBarButton" Content="Ctrl Bar" Tag="key|ControlBar" Click="Action_Click" Width="76" Margin="0,0,0,5" MinHeight="30" Padding="4,5" FontSize="12"
                          ToolTip="Open Control Centre"/>
                  <Button x:Name="AppButton" Content="App" Tag="key|AppSwitch" Click="Action_Click" Width="76" Margin="0,0,0,5" MinHeight="30"
                          ToolTip="Open the app switcher using the phone's Full Keyboard Access shortcut. With Full Keyboard Access off, use the phone's physical app-switching gesture."/>
                  <!-- Says out loud how many phones the strip is about to hit. Input
                       buttons follow the mirror set, so with Mirror to all on, one click
                       is a rack-wide action - that should never be a surprise. -->
                  <TextBlock x:Name="StripTarget" Text="" FontSize="10" TextWrapping="Wrap" Width="76"
                             Foreground="{DynamicResource OkBrush}" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Top">
                  <TextBlock x:Name="WallHeading" Text="Others" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,2,5"/>
                  <Grid>
                    <ItemsControl x:Name="PhoneWall">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,5,5" Padding="2" CornerRadius="4" Background="{DynamicResource TileBrush}" BorderThickness="1.5" Cursor="Hand"
                                  MouseLeftButtonDown="Thumb_Click" Tag="{Binding Id}" ToolTip="{Binding Detail}">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding Following}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource OkBrush}"/></DataTrigger>
                                  <DataTrigger Binding="{Binding Ready}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <StackPanel Width="{Binding DataContext.TileWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                              <Border Background="{DynamicResource StageBrush}" CornerRadius="2" ClipToBounds="True"
                                      Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <Grid>
                                  <Image Source="{Binding Image}" Stretch="Uniform"/>
                                  <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="2,1" IsHitTestVisible="False"
                                          Background="#CC202020">
                                    <TextBlock Text="{Binding DeliveryLabel}" FontSize="8.5" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Foreground" Value="White"/>
                                          <Style.Triggers><DataTrigger Binding="{Binding DeliveryWarning}" Value="True">
                                            <Setter Property="Foreground" Value="#FFFFCC80"/>
                                          </DataTrigger></Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                  </Border>
                                  <!-- The rate is OVERLAID on the picture, never laid out beside it. Text
                                       whose width changes with the number must not be able to resize the
                                       tile, or the whole wall reflows every time a phone's rate moves. -->
                                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                          Background="#8C000000" CornerRadius="2" Padding="3,0,3,1"
                                          Visibility="{Binding RateVisibility}">
                                    <TextBlock Text="{Binding RateText}" FontSize="8.5" Foreground="White"/>
                                  </Border>
                                </Grid>
                              </Border>
                              <TextBlock Text="{Binding ShortName}" FontSize="9.5" TextTrimming="CharacterEllipsis"
                                         TextAlignment="Center" Margin="1,2,1,0"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="WallEmpty" Text="Other mirroring phones appear here." TextWrapping="Wrap" Style="{StaticResource Muted}" FontSize="11" MaxWidth="150" VerticalAlignment="Top" IsHitTestVisible="False"/>
                  </Grid>
                </StackPanel>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
      <!-- ================= Marketing Farm Test Tab ================= -->
      <Grid x:Name="FarmViewSurface" Grid.Row="1" Margin="10" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" MinWidth="260"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="380" MinWidth="320"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Left Column: Live Screen & Jitter Touch Inspector -->
        <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="10" Margin="0,0,8,0">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock x:Name="FarmSelectedPhoneText" Text="Select an iPhone" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="FarmMirrorBadge" Text="○ Offline" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
              <TextBlock x:Name="FarmExecutionModeText" Text="Automation mode: not checked" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Border Background="{DynamicResource TargetBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,6">
                <StackPanel>
                  <TextBlock Text="LAST CONFIRMED TAP" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/>
                  <TextBlock x:Name="FarmLastCoordText" Text="(---, ---)" FontWeight="SemiBold" FontSize="12"/>
                  <TextBlock x:Name="FarmLastApproachText" Text="Exact selected point" Style="{StaticResource Muted}" FontSize="10.5"/>
                  <TextBlock x:Name="FarmLastDwellText" Text="No tap sent" Style="{StaticResource Muted}" FontSize="10.5"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Manual preview controls the real C24C" Style="{StaticResource Muted}" FontSize="10"/>
            </StackPanel>

            <Border Background="{DynamicResource StageBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid Width="250" Height="540">
                <Image x:Name="FarmPhoneImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                <Canvas x:Name="FarmTapCanvas" Background="#01000000" MouseLeftButtonDown="FarmPreview_Down" Cursor="Cross" ToolTip="Tap the selected C24C at the exact point shown; margins are ignored"/>
              </Grid>
            </Border>
          </DockPanel>
        </Border>

        <!-- 2. Middle Column: 1-Click Pipeline, Actions & Phone Wall Cards -->
        <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="12" Margin="0,0,8,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Action Buttons Strip -->
            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
              <Button Content="Create content only" Click="FarmCreateContent_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Review content" Click="FarmOpenContent_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Instagram carousel drafts" Click="FarmCarouselDraft_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Video drafts" Click="FarmVideoDraft_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Read C24C screen" Click="FarmObservation_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Preparation schedule" Click="FarmPreparation_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Review queue" Click="FarmScheduleQueue_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Feature readiness" Click="FarmReadiness_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Check job" Click="FarmCheckJob_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Resume simulation" Click="FarmResumeSimulation_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Create &amp; deploy C24C" Click="FarmAutoCreate_Click" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource OnAccentBrush}" MinHeight="30" Padding="10,5"/>
              <Button Content="Run C24C warmup" Click="FarmCohortWarmup_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Preview schedule" Click="FarmSchedulerTick_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="Check keyword replies" Click="FarmFunnel_Click" MinHeight="30" Padding="10,5"/>
              <Button Content="🔍 Test C24C Spotlight &amp; Notes" Click="FarmSpotlightTest_Click" MinHeight="30" Padding="10,5" ToolTip="Runs live Spotlight Search pill click &amp; types Notes"/>
              <Button Content="Stop C24C + cancel job" Click="FarmEmergencyStop_Click" Foreground="#C62828" MinHeight="30" Padding="10,5"/>
            </WrapPanel>

            <!-- 5-Stage Pipeline Indicator Strip -->
            <Border Grid.Row="1" Background="{DynamicResource TargetBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
              <UniformGrid Columns="5">
                <StackPanel Margin="4,0"><TextBlock Text="1. DRAFT STUDIO" FontWeight="Bold" FontSize="10.5"/><TextBlock Text="Local templates" FontSize="9.5" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Margin="4,0"><TextBlock Text="2. ASSETS" FontWeight="Bold" FontSize="10.5"/><TextBlock Text="JPEG + MP4" FontSize="9.5" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Margin="4,0"><TextBlock Text="3. REVIEW" FontWeight="Bold" FontSize="10.5"/><TextBlock Text="Preview before use" FontSize="9.5" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Margin="4,0"><TextBlock Text="4. KERNEL 9913" FontWeight="Bold" FontSize="10.5"/><TextBlock Text="Scoped input" FontSize="9.5" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Margin="4,0"><TextBlock Text="5. REPLIES" FontWeight="Bold" FontSize="10.5"/><TextBlock Text="Observation required" FontSize="9.5" Style="{StaticResource Muted}"/></StackPanel>
              </UniformGrid>
            </Border>

            <!-- Phone Wall Cards List -->
            <DockPanel Grid.Row="2" LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Text="MARKETING PROFILES · ONLY C24C ENABLED FOR TESTING" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FarmPhoneListPanel"/>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>

        <!-- 3. Right Column: Persona Profile, Content Slate & Live RPC Log -->
        <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Persona Profile Editor -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
              <TextBlock Text="C24C MARKETING PROFILE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
              <TextBlock Text="Niche / Offer Title:" FontSize="11" Style="{StaticResource Muted}"/>
              <TextBox x:Name="FarmNicheBox" Text="AI Workflow &amp; SaaS Clips" MinHeight="26" Margin="0,2,0,6" FontSize="12"/>
              <TextBlock Text="CTA Keyword Trigger:" FontSize="11" Style="{StaticResource Muted}"/>
              <TextBox x:Name="FarmKeywordBox" Text="SYSTEM" MinHeight="26" Margin="0,2,0,6" FontSize="12"/>
              <Button Content="Save C24C profile" Click="FarmSavePersona_Click" MinHeight="26" Margin="0,0,0,6"/>
            </StackPanel>

            <!-- Content Slate Actions -->
            <StackPanel Grid.Row="1" Margin="0,0,0,8">
              <TextBlock Text="CONTENT WORKFLOWS" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
              <UniformGrid Columns="2" Margin="0,0,0,4">
                <Button Content="Instagram draft editor" Click="FarmCarouselDraft_Click" FontSize="11" Padding="4,4"/>
                <Button Content="🎵 TikTok Video" Tag="tiktok|tt_video" Click="FarmDeploySingle_Click" FontSize="11" Padding="4,4"/>
              </UniformGrid>
              <UniformGrid Columns="2">
                <Button Content="𝕏 Video" Tag="x|x_video" Click="FarmDeploySingle_Click" FontSize="11" Padding="4,4"/>
                <Button Content="▶️ YouTube Short" Tag="youtube|yt_short" Click="FarmDeploySingle_Click" FontSize="11" Padding="4,4"/>
              </UniformGrid>
            </StackPanel>

            <!-- Live Kernel JSON-RPC & Activity Log -->
            <DockPanel Grid.Row="2" LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Text="JOB STATUS &amp; ACTIVITY" Style="{StaticResource SectionLabel}" Margin="0,4,0,4"/>
              <TextBox x:Name="FarmLogBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="{DynamicResource LogBrush}"
                       Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"/>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ================= status bar ================= -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="12,5">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusInfo" Text="Not connected" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Large screen" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider x:Name="LargeSize" Minimum="240" Maximum="1500" Value="620" Width="120" VerticalAlignment="Center"
                    ValueChanged="LargeSize_Changed" IsSnapToTickEnabled="True" TickFrequency="10" AutomationProperties.Name="Master screen size"/>
            <Button x:Name="FitButton" Content="Fit" Click="Fit_Click" Style="{StaticResource Quiet}" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Size the master screen to the window"/>
            <ComboBox x:Name="PreviewRate" Width="92" SelectedIndex="3" SelectionChanged="Rate_Changed" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Master refresh rate">
              <ComboBoxItem Content="2 fps" Tag="500"/><ComboBoxItem Content="5 fps" Tag="200"/><ComboBoxItem Content="15 fps" Tag="66"/><ComboBoxItem Content="30 fps" Tag="33"/><ComboBoxItem Content="Max" Tag="1"/>
            </ComboBox>

            <Border Width="1" Background="{DynamicResource EdgeBrush}" Margin="12,2,12,2"/>

            <TextBlock Text="Small screens" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Slider x:Name="SmallSize" Minimum="54" Maximum="300" Value="118" Width="110" VerticalAlignment="Center"
                    ValueChanged="SmallSize_Changed" IsSnapToTickEnabled="True" TickFrequency="2" AutomationProperties.Name="Wall tile size"/>
            <ComboBox x:Name="WallRate" Width="88" SelectedIndex="1" SelectionChanged="WallRate_Changed" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Wall refresh rate">
              <ComboBoxItem Content="Max" Tag="1"/><ComboBoxItem Content="30 fps" Tag="33"/><ComboBoxItem Content="15 fps" Tag="66"/><ComboBoxItem Content="10 fps" Tag="100"/><ComboBoxItem Content="5 fps" Tag="200"/><ComboBoxItem Content="2 fps" Tag="500"/>
            </ComboBox>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ================= drawer ================= -->
    <Grid x:Name="DrawerHost" Visibility="Collapsed">
      <Rectangle Fill="#66000000" MouseLeftButtonDown="CloseDrawer_Click"/>
      <Border HorizontalAlignment="Right" Width="330" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="14,11,10,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="DrawerTitle" Text="Controls" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Close" Click="CloseDrawer_Click" Style="{StaticResource Quiet}"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,12,14">
            <Grid>

              <StackPanel x:Name="ControlsPane">
                <CheckBox x:Name="BatchMode" Checked="Batch_Changed" Unchecked="Batch_Changed">
                  <TextBlock Text="Mirror this phone&#39;s actions to the checked phones" TextWrapping="Wrap"/>
                </CheckBox>
                <WrapPanel Margin="0,6,0,0">
                  <Button Content="Follow: same model" Click="FollowSameModel_Click" FontSize="12"/>
                  <Button Content="Clear" Click="ClearChecks_Click" FontSize="12"/>
                </WrapPanel>
                <Border Background="{DynamicResource TargetBrush}" CornerRadius="5" Padding="9,7" Margin="0,4,0,10">
                  <StackPanel>
                    <TextBlock x:Name="TargetText" Text="Target: select an iPhone" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                    <TextBlock x:Name="MirrorWarning" Text="" TextWrapping="Wrap" Foreground="{DynamicResource WarnBrush}" FontSize="11" Margin="0,5,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>

                <StackPanel x:Name="ActionPanel">
                  <TextBlock Text="NAVIGATION" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                  <UniformGrid Columns="2">
                    <Button Content="Home" Tag="key|Home" Click="Action_Click"/>
                    <Button Content="App switcher" Tag="key|AppSwitch" Click="Action_Click"
                            ToolTip="Uses the phone's Full Keyboard Access shortcut; it may do nothing with Full Keyboard Access off."/><Button Content="Control centre" Tag="key|ControlBar" Click="Action_Click"/>
                  </UniformGrid>
                  <TextBlock Text="App switcher uses the phone's Full Keyboard Access shortcut. If it is off, switch apps on the phone."
                             Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                  <TextBlock Text="SWIPE" Style="{StaticResource SectionLabel}" Margin="0,8,0,7"/>
                  <UniformGrid Columns="4">
                    <Button Content="Up" Tag="swipe|up" Click="Action_Click"/><Button Content="Down" Tag="swipe|down" Click="Action_Click"/>
                    <Button Content="Left" Tag="swipe|left" Click="Action_Click"/><Button Content="Right" Tag="swipe|right" Click="Action_Click"/>
                  </UniformGrid>

                  <TextBlock Text="TYPING" Style="{StaticResource SectionLabel}" Margin="0,8,0,7"/>
                  <!-- No MaxLength: WPF truncates pasted text to it silently. Over-limit text stays visible and Send text refuses it. -->
                  <TextBox x:Name="SendTextBox" Height="54" TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                           TextChanged="SendTextBox_TextChanged" AutomationProperties.Name="Text to type on target phones"/>
                  <TextBlock x:Name="SendTextCount" Text="0 / 200" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"
                             AutomationProperties.Name="Characters in the text box and the Send text limit"/>
                  <Button Content="Send text" Click="SendText_Click" Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                  <UniformGrid Columns="2">
                    <Button Content="Enter" Tag="key|ENTER" Click="Action_Click"/><Button Content="Bksp" Tag="key|BACKSPACE" Click="Action_Click"/>
                  </UniformGrid>

                  <TextBlock Text="POINTER" Style="{StaticResource SectionLabel}" Margin="0,8,0,7"/>
                  <CheckBox x:Name="PointerEnabled" IsChecked="True" Unchecked="PointerTrackingDisabled"><TextBlock Text="Click / drag to control" TextWrapping="Wrap"/></CheckBox>
                  <CheckBox x:Name="TrackPointer" IsChecked="True" Unchecked="PointerTrackingDisabled" Margin="0,3,0,0"><TextBlock Text="Move phone pointer with mouse" TextWrapping="Wrap"/></CheckBox>
                  <CheckBox x:Name="AutoPreview" IsChecked="True" Margin="0,3,0,0" Checked="Live_Changed" Unchecked="Live_Changed"><TextBlock Text="Live view" TextWrapping="Wrap"/></CheckBox>
                  <ComboBox x:Name="CoordSpace" SelectedIndex="0" Margin="0,6,0,0" AutomationProperties.Name="Coordinate space used for taps">
                    <ComboBoxItem Content="Taps: image pixels" Tag="image"/><ComboBoxItem Content="Taps: iOS points" Tag="points"/>
                  </ComboBox>
                  <Button Content="Reset pointer" Tag="reset|mouse" Click="Action_Click" HorizontalAlignment="Stretch" Margin="0,6,0,0"/>
                </StackPanel>
              </StackPanel>

              <StackPanel x:Name="SettingsPane" Visibility="Collapsed">
                <TextBlock Text="SERVICE" Style="{StaticResource SectionLabel}" Margin="0,0,0,7"/>
                <TextBox x:Name="AddressBox" Text="http://127.0.0.1:9911" AutomationProperties.Name="iMouse service address"/>
                <WrapPanel Margin="0,6,0,0">
                  <Button x:Name="ConnectButton" Content="_Connect" Click="Connect_Click" Style="{StaticResource Primary}"/>
                  <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click"/>
                  <Button x:Name="RefreshButton" Content="_Refresh" Click="Refresh_Click"/>
                </WrapPanel>
                <TextBlock Text="The kernel may run on another PC. The phones still cast to that machine." Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>

                <TextBlock Text="CONTROL BOARD" Style="{StaticResource SectionLabel}" Margin="0,14,0,7"/>
                <TextBlock x:Name="BindStatus" Text="Select a phone" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

                <TextBlock Text="DIAGNOSTICS" Style="{StaticResource SectionLabel}" Margin="0,14,0,7"/>
                <UniformGrid Columns="2">
                  <Button x:Name="SaveFrameButton" Content="Save image" Click="SaveImage_Click"/>
                  <Button Content="Export diagnostics" Click="Export_Click"/>
                </UniformGrid>

                <TextBlock Text="DEVICE LIST" Style="{StaticResource SectionLabel}" Margin="0,14,0,7"/>
                <WrapPanel>
                  <Button Content="Check visible" Click="CheckVisible_Click" FontSize="12"/>
                  <Button Content="Clear checks" Click="ClearChecks_Click" FontSize="12"/>
                </WrapPanel>
                <TextBlock x:Name="CheckedCount" Text="0 checked" Style="{StaticResource Muted}" FontSize="11"/>
              </StackPanel>

              <StackPanel x:Name="ActivityPane" Visibility="Collapsed">
                <TextBlock x:Name="LastEvent" Text="Ready to connect." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                <TextBlock x:Name="FrameStatus" TextWrapping="Wrap" Text="Live view idle" Style="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource LogBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="2">
                  <ListBox x:Name="ActivityList" Height="420" Background="Transparent" Foreground="{DynamicResource MutedBrush}" BorderThickness="0" FontSize="11"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Border>
              </StackPanel>

            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
