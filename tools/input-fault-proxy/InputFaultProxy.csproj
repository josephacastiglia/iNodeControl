<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test tooling for live validation: a loopback proxy in front of the running kernel that can
       withhold exactly one answer. It changes nothing in the kernel, the release or the phone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>InputFaultProxy</AssemblyName>
    <RootNamespace>IMouse2.FaultProxy</RootNamespace>
  </PropertyGroup>
</Project>
