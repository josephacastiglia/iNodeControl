# Evidence is stored byte-for-byte. With core.autocrlf on, git otherwise rewrites CRLF
# to LF on commit, and the committed copy no longer matches the hash recorded for it in
# the backup's SHA256SUMS.txt - so it can no longer be checked against the archive.
# This only governs files someone deliberately tracks; it does not track anything.
analysis/**/*.jsonl -text
# Imported evidence must also retain its recorded bytes through checkout.
analysis/accuracy-recovery-20261012/** -text
# The receiver's patches must apply to upstream's LF files, and its build script runs under bash.
tools/airplay/patches/*.patch -text
tools/airplay/build-receiver.sh text eol=lf
tools/airplay/UPSTREAM.md text eol=lf
